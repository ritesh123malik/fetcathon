# Copy to .env. Demo mode needs no external credentials.
DEMO_MODE=true
DATABASE_PATH=data/supplyrescue.sqlite3
ASI_ONE_API_KEY=
ASI_MODEL=asi1
AGENTVERSE_API_KEY=
# Generate a private stable seed with: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_SEED=
AGENT_MAILBOX=true
AGENT_ENDPOINT=http://127.0.0.1:8100/submit
# Required for non-demo deployment. Dashboard asks for this key; never embed in JS.
ADMIN_API_KEY=
# Set after registration to show a real profile link in the UI.
AGENT_PROFILE_URL=
